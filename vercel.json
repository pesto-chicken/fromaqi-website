{
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "redirects": [
    { "source": "/index_en.html", "destination": "/", "permanent": true },
    { "source": "/menu_en.html", "destination": "/menu.html", "permanent": true }
  ]
}
